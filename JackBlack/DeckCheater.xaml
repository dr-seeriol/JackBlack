<Window x:Class="JackBlack.DeckCheater"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JackBlack"
        mc:Ignorable="d"
        Title="DeckCheater" Height="440" Width="400">
    <Window.Resources>
        <local:CardToImageConverter x:Key="cardConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="deckListBox" Grid.Row="0" Grid.Column="0"
                 ItemsSource="{Binding Deck}"/>

        <Image Grid.Row="0" Grid.Column="1" Width="72" Margin="10,0,0,0" VerticalAlignment="Top"
               Source="{Binding SelectedItem, ElementName=deckListBox,
                                Converter={StaticResource cardConverter}}"/>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Move Up" Width="90" Margin="5" Click="MoveUp_Click"/>
            <Button Content="Move Down" Width="90" Margin="5" Click="MoveDown_Click"/>
        </StackPanel>
    </Grid>
</Window>
